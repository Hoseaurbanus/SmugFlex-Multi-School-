# Database Configuration
DB_HOST=localhost
DB_NAME=smugflex_platform
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
SUPER_ADMIN_JWT_SECRET=your-super-admin-secret-change-in-production
JWT_EXPIRY=86400

# API Configuration
API_BASE_URL=http://localhost/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Configuration
UPLOAD_PATH=../uploads
MAX_FILE_SIZE=5242880

# Email Configuration (Optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# School Settings
SCHOOL_NAME=My School
SCHOOL_EMAIL=admin@smschool.com
SCHOOL_PHONE=+234-800-000-0000
SCHOOL_ADDRESS=123 Education Street, Lagos, Nigeria

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# Super Admin WhatsApp (for registration notifications)
SUPER_ADMIN_WHATSAPP=2349030031278
