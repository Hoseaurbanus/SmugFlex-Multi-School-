# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# JWT Secrets - IMPORTANT: Generate unique secrets for production
# Use: openssl rand -hex 32
JWT_SECRET=generate_a_unique_secret_here
SUPER_ADMIN_JWT_SECRET=generate_another_unique_secret_here
JWT_EXPIRY=86400

# API Configuration
API_BASE_URL=http://localhost/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Settings
UPLOAD_PATH=../uploads
MAX_FILE_SIZE=5242880

# School Defaults (used in multi-tenant mode)
SCHOOL_NAME=Your School Name
SCHOOL_EMAIL=admin@yourschool.com
SCHOOL_PHONE=+234-800-000-0000
SCHOOL_ADDRESS=123 Education Street, Lagos, Nigeria

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# Payment Gateway (optional)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
